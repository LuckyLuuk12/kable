{
  "name": "kable",
  "description": "A Minecraft launcher",
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "web:dev": "vite dev",
    "dev": "npm run generate:image-keys && tauri dev",
    "build": "npm run format && npm run generate:image-keys && vite build",
    "build:quiet": "vite build 2>&1 | findstr /V \"Deprecation [legacy-js-api]\" | findstr /V \"More info:\"",
    "build:crates": "npm run build:backend && npm run build:api-types && npm run build:api-typegen && npm run build:kable-macros",
    "build:backend": "cd src-tauri && cargo build --release && cd ..",
    "build:api-types": "cd api-types && cargo build --release && cd ..",
    "build:api-typegen": "cd api-typegen && cargo build --release && cd ..",
    "build:kable-macros": "cd kable-macros && cargo build --release && cd ..",
    "preview": "vite preview",
    "format": "npm run format:frontend && npm run format:backend && npm run format:api-types && npm run format:api-typegen && npm run format:kable-macros",
    "format:frontend": "prettier --write ./src/",
    "format:backend": "cd src-tauri && cargo fmt && taplo fmt Cargo.toml && cd ..",
    "format:api-types": "cd api-types && cargo fmt && taplo fmt Cargo.toml && cd ..",
    "format:api-typegen": "cd api-typegen && cargo fmt && taplo fmt Cargo.toml && cd ..",
    "format:kable-macros": "cd kable-macros && cargo fmt && taplo fmt Cargo.toml && cd ..",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate:image-keys": "node scripts/generate-image-keys.mjs",
    "generate:wix-images": ".venv\\Scripts\\python.exe scripts/generate-wix-images.py",
    "typegen": "cd api-typegen && cargo run",
    "version": "npm run build && node scripts/bump-version.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:watch": "chokidar \"src/**/*.{ts,svelte,js}\" -c \"npm run lint\""
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.10.0",
    "@typescript-eslint/parser": "^8.62.1",
    "@typescript-eslint/utils": "^8.62.1",
    "cookie": ">=0.7.0",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.5.0",
    "sass": "^1.89.2",
    "semver": "^7.7.3",
    "svelte": "^5.53.5",
    "svelte-check": "^4.7.2",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@types/semver": "^7.7.1",
    "marked": "^17.0.3",
    "skinview3d": "^3.4.1",
    "svelte-dnd-action": "^0.9.69"
  }
}
