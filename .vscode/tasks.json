{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint project",
      "type": "npm",
      "script": "lint",
      "problemMatcher": [
        "$eslint-stylish"
      ],
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "showReuseMessage": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Lint watch",
      "type": "npm",
      "script": "lint:watch",
      "isBackground": true,
      "problemMatcher": [
        "$eslint-stylish"
      ],
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "Svelte type check",
      "type": "npm",
      "script": "check",
      "problemMatcher": {
        "owner": "svelte-check",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+)\\s+-\\s+(error|warning)\\s+-\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "presentation": {
        "reveal": "never"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}